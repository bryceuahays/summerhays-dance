---
// Before launch: waitlist form in place of the schedule. After launch: the
// booking tool's live embed (or, until it exists, the class list), with a
// link to the booking tool's own page. Pricing shows either way.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionIntro from '../components/SectionIntro.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import PricingCards from '../components/PricingCards.astro';
import SignupForm from '../components/SignupForm.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import { bookAction, getSite } from '../lib/site';
import { getPage, getPricing, getSchedule } from '../lib/content';

const site = await getSite();
const page = (await getPage('schedulePage')).data;
const classes = await getSchedule();
const prices = await getPricing('classes');
---

<Base title={page.title} description={page.description}>
  <PageHeader heading={page.heading} intro={site.prelaunch ? undefined : page.intro} />

  {
    site.prelaunch ? (
      <section class="section" id="schedule">
        <div class="container schedule-prelaunch">
          <SectionIntro heading={page.prelaunch.heading} intro={page.prelaunch.text} />
          <div class="schedule-prelaunch__form">
            <SignupForm id="schedule" />
          </div>
        </div>
      </section>
    ) : (
      <section class="section" id="schedule">
        <div class="container">
          {!site.booking.embedCode && <ScheduleTable classes={classes} caption={page.heading} />}
          <div class="schedule-booking">
            <BookingEmbed fallbackLabel={page.fallbackLinkLabel} />
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--sand" id="pricing">
    <div class="container">
      <SectionIntro heading={page.pricingHeading} intro={page.pricingIntro} />
      <PricingCards cards={prices} action={bookAction(site)} />
    </div>
  </section>
</Base>

<style>
  .schedule-prelaunch {
    display: grid;
    gap: var(--space-4);
  }

  .schedule-prelaunch__form {
    max-width: 720px;
    padding: var(--space-3);
    background: var(--cream);
    border: 1px solid var(--sand);
    border-radius: var(--radius-card);
  }

  .schedule-booking {
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .schedule-prelaunch__form {
      padding: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .schedule-prelaunch {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
