---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
import { getPage } from '../lib/content';

const page = (await getPage('notFound')).data;
---

<Base title={page.title} description={page.description} noindex>
  <section class="section not-found">
    <div class="container not-found__inner">
      <h1>{page.heading}</h1>
      <p class="lede">{page.text}</p>
      <a class="btn" href={url('/')}>{page.linkLabel}</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    align-items: center;
    min-height: min(70svh, 720px);
    background: var(--blush);
  }

  .not-found__inner {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }
</style>
