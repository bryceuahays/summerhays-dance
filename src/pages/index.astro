---
// Pass 1 scaffold: a stand-in home page so the layout, header, footer and
// offer bar can be reviewed. Pass 4 replaces it with the real home page.
import Base from '../layouts/Base.astro';
import { bookAction, getSite } from '../lib/site';

const site = await getSite();
const book = bookAction(site);
---

<Base overHero>
  <section class="section scaffold-hero on-dark">
    <div class="container stack">
      <p class="eyebrow">{site.city}, {site.state}</p>
      <h1>{site.name}</h1>
      <p class="scaffold-hero__lede">{site.positioning}</p>
      <div class="btn-row">
        <a class="btn" href={book.href}>{book.label}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <div class="placeholder scaffold-photo">PHOTO: class in motion (pass 4)</div>
    </div>
  </section>

  <section class="section section--blush">
    <div class="container reveal">
      <div class="placeholder">PHOTO: Brielle teaching (pass 4)</div>
    </div>
  </section>
</Base>

<style>
  .scaffold-hero {
    background: var(--plum-deep);
    color: var(--cream);
    min-height: min(80vh, 720px);
    display: flex;
    align-items: flex-end;
  }

  .scaffold-hero .eyebrow {
    color: var(--blush);
  }

  .scaffold-hero__lede {
    font-size: 1.25rem;
    max-width: 36ch;
  }

  .scaffold-photo {
    min-height: 360px;
  }
</style>
