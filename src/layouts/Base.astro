---
import '../styles/global.css';
import IntroOfferBar from '../components/IntroOfferBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { getSite, url } from '../lib/site';
import { getPage } from '../lib/content';

interface Props {
  /** Page title; the home page leaves it out and uses the business name. */
  title?: string;
  description?: string;
  /** The page opens with a dark full-bleed hero the header sits on top of. */
  overHero?: boolean;
  noindex?: boolean;
}

const site = await getSite();
const { title, description = site.description, overHero = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Share image: the one set in site.yaml, else the home hero photo once it exists.
const shareSource = site.socialImage ?? (await getPage('home')).data.hero.photo.src;
const shareImage = shareSource
  ? new URL((await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site)
  : undefined;
const analytics = site.analytics;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#06434D" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />

    {
      analytics.enabled && analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
        />
      )
    }
    {
      analytics.enabled && !analytics.cloudflareToken && analytics.scriptSrc && (
        <script is:inline defer src={analytics.scriptSrc} data-domain={analytics.dataDomain || undefined} />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.ui.skipLink}</a>
    <IntroOfferBar site={site} />
    <Header site={site} overHero={overHero} />
    <main id="main" tabindex="-1" class:list={{ 'over-hero': overHero }}>
      <slot />
    </main>
    <Footer site={site} />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  /* A page with overHero pulls its first section up under the transparent header */
  main.over-hero > :global(:first-child) {
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + var(--section-pad));
  }
</style>
