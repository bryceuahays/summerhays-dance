---
// A content photo. Until the shoot, `src` is empty and a sand placeholder
// block shows the photo that's needed, labeled from the alt text.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSite } from '../lib/site';

interface Props {
  photo: { src?: ImageMetadata; alt: string };
  /** Width / height, e.g. "4 / 3". The placeholder keeps the same shape. */
  ratio?: string;
  /** Responsive sizes hint, e.g. "(min-width: 768px) 50vw, 100vw". */
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
}

const {
  photo,
  ratio = '4 / 3',
  sizes = '100vw',
  widths = [480, 768, 1080, 1440, 1920],
  loading = 'lazy',
} = Astro.props;
const site = await getSite();
const src = photo.src;
const fits = src ? widths.filter((w) => w <= src.width) : [];
---

{
  src ? (
    <Image
      class="photo"
      src={src}
      alt={photo.alt}
      widths={fits.length ? fits : [src.width]}
      sizes={sizes}
      loading={loading}
      style={{ aspectRatio: ratio }}
    />
  ) : (
    <div class="placeholder photo" style={{ aspectRatio: ratio }}>
      <span>
        {site.ui.photoLabel} {photo.alt}
      </span>
    </div>
  )
}
