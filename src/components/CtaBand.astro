---
// Closing call to action on a dark teal band.
interface Props {
  cta: { heading: string; text?: string };
  /** Pages pass bookAction(site, cta.buttonLabel) so prelaunch mode swaps it to the waitlist. */
  action: { href: string; label: string };
}

const { cta, action } = Astro.props;
---

<section class="section section--dark on-dark cta-band">
  <div class="container cta-band__inner reveal">
    <h2>{cta.heading}</h2>
    {cta.text && <p class="cta-band__text">{cta.text}</p>}
    <a class="btn" href={action.href}>{action.label}</a>
  </div>
</section>

<style>
  .cta-band__inner {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }

  .cta-band h2 {
    max-width: 18ch;
  }

  .cta-band__text {
    max-width: 40ch;
    font-size: 1.125em;
    opacity: 0.9;
  }
</style>
