---
// Hip hop, jazz, contemporary: a photo and one line each.
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import SectionIntro from './SectionIntro.astro';

interface Props {
  heading: string;
  items: { name: string; text: string; photo: { src?: ImageMetadata; alt: string } }[];
}

const { heading, items } = Astro.props;
---

<div>
  <SectionIntro heading={heading} />
  <ul class="tiles" role="list">
    {
      items.map((item) => (
        <li class="tile reveal">
          <Photo photo={item.photo} ratio="4 / 5" sizes="(min-width: 768px) 33vw, 100vw" />
          <h3 class="tile__name">{item.name}</h3>
          <p class="tile__text">{item.text}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .tiles {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .tile :global(.photo) {
    margin-bottom: var(--space-1);
  }

  .tile__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .tile__text {
    color: var(--muted);
  }

  /* Two across on tablets would orphan the third, so phones scroll down
     and wider screens get all three in a row. */
  @media (min-width: 768px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
    }
  }
</style>
