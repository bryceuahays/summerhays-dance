---
// Opening band for pages without a photo hero: eyebrow, H1, one-line intro.
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
}

const { eyebrow, heading, intro } = Astro.props;
---

<section class="section page-header">
  <div class="container page-header__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{heading}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    background: var(--mist);
    padding-bottom: var(--space-8);
  }

  .page-header__inner {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .page-header h1 {
    max-width: 16ch;
  }

  .page-header .lede {
    max-width: 46ch;
  }
</style>
