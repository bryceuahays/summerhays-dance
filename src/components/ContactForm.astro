---
// Contact page form: name, email, message. Labels from pages/contact.yaml;
// the form service address from site.yaml.
import type { CollectionEntry } from 'astro:content';
import FormField from './FormField.astro';
import ServiceForm from './ServiceForm.astro';
import { getSite } from '../lib/site';

interface Props {
  form: CollectionEntry<'contact'>['data']['form'];
}

const { form } = Astro.props;
const site = await getSite();
---

<ServiceForm
  id="contact"
  action={site.forms.contactAction}
  submitLabel={form.submitLabel}
  successMessage={form.successMessage}
>
  <div class="form-grid">
    <FormField id="contact-name" name="name" field={form.name} autocomplete="name" required />
    <FormField id="contact-email" name="email" type="email" field={form.email} autocomplete="email" required />
  </div>
  <FormField id="contact-message" name="message" type="textarea" field={form.message} required />
</ServiceForm>

<style>
  .form-grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
